import java.util.*;

public class Main {
    public static int findLargest (){
      Scanner sc=new Scanner(System.in);
      int a=sc.nextInt();
      int b=sc.nextInt();
      int c=sc.nextInt();
      return Math.max(Math.max(a,b),c);
  }
  public static void main(String[]args){
    System.out.println(findLargest());
  }
}
