import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        int sum = 0, temp = num, n = num;
        int digits = 0;
        while (n > 0) {
            digits++;
            n /= 10;
        }
        while (temp > 0) {
            int digit = temp % 10;
            sum += (int) Math.pow(digit, digits);
            temp /= 10;
        }
        if(num==sum)
        System.out.println ("YES");
        else
        System.out.println ("NO");
    }
}
