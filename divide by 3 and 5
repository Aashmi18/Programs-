import java.util.*;

public class Main {
    public static  String CheckDivisibility(int n) {
      if(n%3==0||n%5==0){
        return  "YES";
      }else{
        return "NO";
      }
  }
  public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int num = sc.nextInt();
      System.out.println(CheckDivisibility(num));
}
}
